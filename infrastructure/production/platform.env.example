NODE_ENV=production
PORT=4003
CORS_ORIGIN=https://your-web-domain.example
DATABASE_URL=postgresql://USER:PASSWORD@DB_HOST:5432/platform
IDENTITY_ISSUER=anpardaz-platform
IDENTITY_PRIVATE_KEY_B64=BASE64-DER-ED25519-PRIVATE-KEY
GUEST_INTERACTION_SECRET=GENERATE_A_LONG_RANDOM_SECRET
# Set true only when the service is reachable exclusively through a trusted reverse proxy.
TRUST_PROXY=false
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
MARKET_DATA_INTERVAL_MS=30000
MARKET_DATA_SYMBOLS=BTC-USDT,ETH-USDT,BTC-IRT,ETH-IRT
HOOSH_WORKER_ENABLED=false
HOOSH_WORKER_INTERVAL_MS=1000
